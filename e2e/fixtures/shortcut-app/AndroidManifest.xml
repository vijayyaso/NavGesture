<!-- A test app that publishes run-time (dynamic) shortcuts the way GPay does, for the
     shortcuts e2e suite. Built by build.sh with the plain SDK tools; not part of the app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.vijayyaso.navgesture.fixture.shortcuts"
    android:versionCode="1"
    android:versionName="1">

    <uses-sdk android:minSdkVersion="30" android:targetSdkVersion="36" />

    <application android:label="NG Shortcut Fixture">
        <activity
            android:name=".LauncherActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported: a shortcut aimed here must never be listed by NavGesture. -->
        <activity
            android:name=".PrivateActivity"
            android:exported="false" />
    </application>
</manifest>
