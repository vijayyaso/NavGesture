<!-- Strings for the github build only: the update check (its only network use), and the
     service description, which names that check. The play build words it without. -->
<resources>
    <string name="accessibility_service_description">Recognises swipes from the screen edges and performs Back, Home and Recents. The service is for navigation alone, and it doesn\'t read screen content or keystrokes or send anything off your device. The app itself contacts GitHub only if you turn on its update check.</string>

    <!-- Update check. Off by default, and the only code that touches the network. -->
    <string name="update_switch">Check for updates</string>
    <string name="update_switch_body">Asks GitHub for the latest release once a day as you open the app.</string>
    <string name="update_summary_up_to_date">Up to date</string>
    <string name="update_summary_available">Update available (%1$s)</string>
    <string name="update_summary_checking">Checking…</string>
    <string name="update_summary_no_network">No connection</string>
    <string name="update_summary_rate_limited">GitHub is limiting requests</string>
    <string name="update_summary_http_error">GitHub answered HTTP %1$d</string>
    <string name="update_summary_bad_response">Unreadable answer from GitHub</string>
    <string name="update_summary_no_apk">%1$s has no APK yet</string>
    <string name="update_summary_nothing_published">No release yet</string>
    <string name="update_summary_unreadable_version">Could not compare versions</string>
    <string name="update_status">Latest release</string>
    <string name="update_not_checked">Not checked yet</string>
    <string name="update_check_now">Check now</string>
    <string name="update_download_install">Download and install</string>
    <string name="update_allow_installs">Allow installs</string>
    <string name="update_last_checked">Last checked %1$s</string>
    <string name="update_checking">Asking GitHub for the newest release…</string>
    <string name="update_up_to_date">Up to date. You have %1$s and the newest release is %2$s.</string>
    <string name="update_available">%1$s is available. You have %2$s.</string>
    <string name="update_no_apk">Release %1$s has no APK attached, so there is nothing to install yet.</string>
    <string name="update_nothing_published">GitHub doesn\'t list a published release yet.</string>
    <string name="update_unreadable_version">Could not compare versions, because %1$s is not a version number.</string>
    <string name="update_no_network">Could not reach GitHub (%1$s). Check the connection and try again.</string>
    <string name="update_rate_limited">GitHub is limiting requests from this network. Try again later.</string>
    <string name="update_rate_limited_until">GitHub is limiting requests from this network. Try again after %1$s.</string>
    <string name="update_http_error">GitHub answered with HTTP %1$d. Try again later.</string>
    <string name="update_bad_response">GitHub sent an answer this app could not read (%1$s).</string>
    <string name="update_downloading">Downloading %1$s…</string>
    <string name="update_permission_needed">Android needs your permission before NavGesture can install an update. Allow it, come back here, and the download starts.</string>
    <string name="update_confirming">Confirm the update in the system prompt.</string>
    <string name="update_checksum_mismatch">The download did not match the checksum GitHub published, so it was deleted and nothing was installed.</string>
    <string name="update_blocked_host">The download was redirected to %1$s, which is not a GitHub host, so it was stopped.</string>
    <string name="update_download_failed">The download failed (%1$s). Try again.</string>
    <string name="update_install_failed">The update did not install (%1$s).</string>
    <string name="update_signature_conflict">Android refused the update, because it is signed with a different key from this copy (%1$s).</string>
    <string name="update_declined">The update was cancelled in the system prompt, and this copy stays as it was.</string>
    <string name="update_installed">Update installed.</string>
</resources>
